# Copy to .env.local for development, or .env.production on your server.
# Never commit a real .env file — only this example stays in git.

# Supabase — create a free project at supabase.com, then Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin panel (/admin) — pick your own values, keep them long/random
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me-too
ADMIN_EMAIL=you@example.com

# Resend — resend.com, used for order confirmation + contact form emails
RESEND_API_KEY=re_your_api_key
RESEND_FROM=orders@yourdomain.com

# Upstash Redis — upstash.com, used for per-IP rate limiting
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional — leave unset to disable analytics entirely (no consent banner either)
NEXT_PUBLIC_GA_ID=
